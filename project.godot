; Engine configuration file.
; Golf Battle 3D - Godot 4.5 (Mobile-Renderer, Jolt-Physik, Hochformat)

config_version=5

[application]

config/name="Golf Battle 3D"
config/description="3D-Arcade-Multiplayer-Golf: 15 Bahnen, 4 Welten, Bots, Supabase-Multiplayer."
config/version="1.0.0"
run/main_scene="res://scenes/MainMenu3D.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.039, 0.07, 0.13, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
AuthManager="*res://scripts/autoload/AuthManager.gd"
ProfileManager="*res://scripts/autoload/ProfileManager.gd"
NetworkManager="*res://scripts/autoload/NetworkManager.gd"
SoundManager="*res://scripts/autoload/SoundManager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=5

[gui]

theme/default_font_multichannel_signed_distance_field=false

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="welt"
3d_physics/layer_2="baelle"
3d_physics/layer_3="hindernisse"
3d_physics/layer_4="plattformen"

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=20.0
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size=1024
environment/defaults/default_clear_color=Color(0.039, 0.07, 0.13, 1)
